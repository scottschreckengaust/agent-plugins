# EditorConfig helps maintain consistent coding styles across editors and IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Preserve trailing spaces in Markdown (used for line breaks)
trim_trailing_whitespace = false

[Makefile]
# Makefiles require tabs for indentation
indent_style = tab

[*.{sh,bash}]
indent_size = 2
indent_style = space
